<%@ tag description="Provides access to session constants" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<c:set var="ACTION_PARAM" value="action" scope="request"/>
<c:set var="ANSWER_ID_PARAM" value="answerId" scope="request"/>
<c:set var="QUEST_ATTR" value="quest" scope="request"/>
<c:set var="CURRENT_QUESTION_ATTR" value="currentQuestion" scope="request"/>
<c:set var="FIRST_GET_PROCESSED_ATTR" value="firstGetProcessed" scope="request"/>
<c:set var="GAMES_PLAYED_ATTR" value="gamesPlayed" scope="request"/>
<c:set var="WIN_ATTR" value="win" scope="request"/>
<c:set var="ERROR_MESSAGE_ATTR" value="errorMessage" scope="request"/>