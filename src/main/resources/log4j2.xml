<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Properties>
        <Property name="SPRING"
                  value="%style{%d{ISO8601}}{black} %highlight{%-5level }[%style{%t}{bright,blue}] %style{%C{1.}}{bright,yellow}.%M(%F:%L): %msg%n%throwable"/>
    </Properties>
    <Appenders>
        <RollingFile
                name="RollingFile"
                fileName="${sys:catalina.base}/logs/project-pantera.log"
                filePattern="${sys:catalina.base}/logs/project-pantera.%d{yyyy-MM-dd}.log">
<!--            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{1}: %msg%n"/>-->
            <PatternLayout pattern="${sys:SPRING}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="logs/" maxDepth="1">
                    <IfFileName glob="project-pantera.*.log"/>
                    <IfLastModified age="7D"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <Console name="Console" target="SYSTEM_OUT">
<!--            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{1}: %msg%n"/>-->
            <PatternLayout pattern="${sys:SPRING}"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="com.javarush.vasileva.cmd.Login" level="DEBUG"/>
        <Logger name="com.javarush.vasileva.cmd.EditUser" level="DEBUG"/>
    </Loggers>
</Configuration>