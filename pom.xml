<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javarush.ushanov</groupId>
    <artifactId>project-pantera</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!--
        packaging war означает: Maven упакует проект в .war файл
        (Web Application Archive) — именно такой файл деплоится на Tomcat
    -->
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            Jakarta Servlet API — позволяет нам писать сервлеты.
            scope=provided означает: эта библиотека уже есть в Tomcat,
            не нужно включать её в наш .war файл
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JSTL — теги для JSP страниц, например <c:if>, <c:forEach>
            Позволяют писать логику в JSP без Java-кода
        -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!--
            Lombok — генерирует boilerplate-код (геттеры, сеттеры,
            конструкторы, toString) через аннотации вроде @Getter, @Data
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!--
            SLF4J — это интерфейс (API) для логирования.
            Твой код пишет через SLF4J, не привязываясь к конкретной библиотеке логов.
            Это как розетка — стандарт один, а что за ним стоит — можно менять.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>

        <!--
            Logback — конкретная реализация логирования за "розеткой" SLF4J.
            Именно он реально записывает логи в консоль или файл.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.32</version>
        </dependency>

        <!--
            JUnit 5 — фреймворк для написания тестов
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-war-plugin — плагин для сборки .war файла
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <!--
                maven-surefire-plugin — плагин для запуска тестов через Maven
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>
</project>